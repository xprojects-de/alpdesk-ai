# Settings of the production installation, read by docker-compose.prod.yml. Copy to .env on the server once, replace
# every CHANGE_ME, keep it there: checking out a release's tag replaces the tracked files, never .env (ignored by git).
# A value containing $ goes into single quotes ('...'), otherwise compose would read it as a variable.
# The app refuses to start while a secret is still CHANGE_ME (README.md "Configuration").

# The domain Caddy serves and fetches the certificate for, without https://
APP_DOMAIN=CHANGE_ME

# The admin login - the password at least 12 characters
APP_USERNAME=CHANGE_ME
APP_PASSWORD=CHANGE_ME
# openssl rand -base64 48 - changing it logs the admin and every tenant user out (API keys and MCP keys are not
# affected)
JWT_GENERATOR_SIGNATURE_SECRET=CHANGE_ME
# openssl rand -base64 32 - encrypts the stored keys (AI providers, connected software, own model servers), the file
# stores' passwords and the sandboxes' tokens: back it up, losing or changing it means entering them again
APP_SECRET_KEY=CHANGE_ME
# openssl rand -base64 48 - only counts when ./pgdata is created; afterwards change it with ALTER ROLE first
DB_PASSWORD=CHANGE_ME
# Optional - a PostgreSQL server of its own instead of the pod's (README.md "Sizing PostgreSQL"): its address with TLS
# and the role the app uses there (CREATEDB - it creates every tenant's database); DB_PASSWORD is that role's password.
# Then remove the service "postgres" and the "depends_on" on it from the compose file.
#DATASOURCES_DEFAULT_URL=jdbc:postgresql://db.example.com:5432/alpdesk_ai?sslmode=require
#DATASOURCES_DEFAULT_USERNAME=alpdeskai

# Optional - the look of the installation (login page, the admin's dashboard, every tenant without its own look, which
# the admin sets per tenant in the frontend). The logo: a PNG, JPEG or WebP of at most 512 KB, copied into the volume
# "files" once (podman cp logo.png alpdesk-ai:/home/app/files/branding-logo.png). An invalid value stops the start.
#APP_BRANDING_NAME=Zirmo
#APP_BRANDING_PRIMARY_COLOR=#49732a
# Without APP_BRANDING_LOGO the Zirmo logo is shown; empty (APP_BRANDING_LOGO=) shows none.
#APP_BRANDING_LOGO=/home/app/files/branding-logo.png

# Optional - the daily report by e-mail (README.md "Daily report"): every morning at 06:00 to these addresses (comma
# separated), also when everything is fine - a missing one means the app or sending mail is down. Without a mail
# server or recipients nothing is sent. APP_MAIL_SECURITY: STARTTLS (port 587), SSL (port 465) or NONE; APP_MAIL_FROM
# defaults to APP_MAIL_USERNAME. A recipient that is no e-mail address, or a mail server without a sender address
# (neither APP_MAIL_FROM nor an address as APP_MAIL_USERNAME), stops the start - the log names the setting.
#APP_MONITORING_MAIL_TO=ops@example.com
#APP_MAIL_HOST=smtp.example.com
#APP_MAIL_PORT=587
#APP_MAIL_SECURITY=STARTTLS
#APP_MAIL_USERNAME=report@example.com
#APP_MAIL_PASSWORD=CHANGE_ME
#APP_MAIL_FROM=report@example.com
# Another time: a cron expression (seconds minutes hours day month weekday) in the time zone Europe/Berlin.
#APP_MONITORING_DAILY_REPORT_CRON=0 0 6 * * *

# Optional - the chat's files. The size a video may have (only for tenants with a sandbox - README.md "Code execution";
# at most 512MB, the server's request limit). How long files stay before they are deleted: a video the hours after its
# upload, every other file (uploaded or created) the days after it was stored - set one empty (e.g.
# APP_CHAT_FILE_RETENTION_DAYS=) to keep those files until they or their conversation are deleted. The conversation
# keeps a deleted file listed as expired. When the cleanup runs: a cron expression (seconds first), every hour.
#APP_CHAT_VIDEO_MAX_SIZE=500MB
# The rounds the assistant may take for an answer about a video (frames, looking, searching, drawing) - more cost more.
#APP_CHAT_VIDEO_ROUNDS=16
# A tenant answering through its A2A agent: how long the agent may take, and the longest answer kept.
#APP_A2A_TIMEOUT=10m
#APP_A2A_MAX_ANSWER_CHARS=200000
# How long the company's assistant keeps a question answered as an A2A task (streamed) for its key - empty keeps it.
#APP_A2A_TASK_RETENTION_HOURS=24
#APP_CHAT_VIDEO_RETENTION_HOURS=8
#APP_CHAT_FILE_RETENTION_DAYS=14
#APP_CHAT_CLEANUP_CRON=0 0 * * * *

# Optional - how many of a search's candidates a tenant's reranker reorders (2 to 40). On a CPU the reranker takes about
# a second per candidate and the search waits for it 30 seconds at most: 10 suits a CPU, 20 a GPU. Keep it above the
# tenants' number of search results (usually 5) - the reranker then picks the best of more.
#APP_SEARCH_RERANK_CANDIDATES=10
# The reranker's TEI image (docker-compose.reranker.yml, docker-compose.reranker-gpu.yml): one per architecture or GPU
# generation - e.g. cpu-arm64-1.9.4 on an ARM server, 86-1.9.4 for an A10 (README.md "Reranking with a local reranker").
#RERANKER_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9.4

# Optional - the largest ZIP a handbook's website may be uploaded as (at most 512MB, the server's request limit).
#APP_DOC_SITE_MAX_ZIP_SIZE=100MB

# Optional - own model servers (Ollama, OpenAI-compatible; the admin enters them in the model catalog). They are reached
# over HTTPS only; plain HTTP only to the hosts listed here, comma separated (a server in the same pod or the internal
# network, e.g. ollama,10.0.0.5). A listed host is reachable on any port - also as the address of connected software
# (MCP), which every tenant admin enters: never list localhost or the app's own container.
#APP_AI_PLAIN_HTTP_HOSTS=
# A server with a certificate of the company's own authority: copy the authority's certificate (PEM, *.crt) into the
# volume's certificates/ (or mount a folder there) and set 1 (README.md "Own model servers") - the certificate check
# stays on.
#USE_SYSTEM_CA_CERTS=1

# Optional - file stores (SFTP, FTPS servers the tenant admins enter, e.g. where their software writes its log files)
# may not lie in an internal network - except on the hosts listed here, comma separated (e.g. logs.intern,10.0.5.20).
# Every tenant admin may then enter them: never list localhost, the database or the app's own container.
#APP_FILE_STORE_INTERNAL_HOSTS=

# Optional - a scheduled task's run keeps the lines its steps read (masked as the task says); it is deleted this many
# days after it ended. Set empty (APP_TASK_RUN_RETENTION_DAYS=) to keep runs until a tenant admin deletes them.
#APP_TASK_RUN_RETENTION_DAYS=14

# Code execution (Python and shell in the chat) needs nothing here: every tenant that wants it gets a sandbox of its
# own, started from docker-compose.tenant-sandbox.yml with its own file in sandboxes/ (README "Code execution").

# Optional - behind an own reverse proxy instead of Caddy (docker-compose.proxy.yml, README.md "Behind an own reverse
# proxy": a NAS, an nginx serving other applications): where the app's port is published for the proxy - the
# loopback interface unless the proxy runs on another machine of a trusted network. APP_DOMAIN is not needed then: the
# proxy holds the domain and the certificate.
#APP_LISTEN=127.0.0.1:19100

# Optional - behind a reverse proxy under a sub-path (e.g. nginx at https://intranet.example.com/alpdesk-ai/): the path,
# without a trailing slash. Everything is then served below it (README.md "Behind a reverse proxy under a
# sub-path", with the nginx configuration).
#MICRONAUT_SERVER_CONTEXT_PATH=/alpdesk-ai

# Optional - sign-in through a WAM proxy in front of the app (README.md "Sign-in through a WAM proxy"):
# tenant users sign in with the user name the proxy sends in APP_WAM_USER_HEADER and have no password; the admin keeps
# APP_USERNAME / APP_PASSWORD. Only with a proxy that removes these headers from every request from outside - and the
# app reachable through it only: the app trusts them completely.
#APP_WAM_ENABLED=true
#APP_WAM_USER_HEADER=X-Remote-User
#APP_WAM_NAME_HEADER=X-Remote-Name
# Optional - the person's IDM groups from the proxy, e.g. "Gruppe1,Gruppe2": a user group with a WAM group counts only
# while the proxy lists it - without this setting it counts for nobody (README.md "Sign-in through a WAM proxy"). The
# proxy must remove this header from outside requests too.
#APP_WAM_GROUPS_HEADER=X-Remote-Groups
#APP_WAM_GROUPS_SEPARATOR=,

# Optional - the app's memory. Without it the JVM takes a quarter of the server's memory as its heap and keeps running
# after it ran out of it. A fixed heap (about half of what the server has for the app: 2g on a server with 8 GB, 1g on
# 4 GB) makes it predictable, and with ExitOnOutOfMemoryError the container restarts cleanly instead of going on half
# working - running answers of every company end with it.
#JAVA_TOOL_OPTIONS=-Xmx2g -XX:+ExitOnOutOfMemoryError

# A frontend of your own for the users on another origin (README.md "A frontend of your own for the users"): its
# origins, comma-separated, exactly as the browser sends them - never "*". Not needed when it is served under this
# installation's own address.
#APP_CORS_ORIGINS=https://chat.example.com
